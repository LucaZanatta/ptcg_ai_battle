{
  "protocol": "c009 identity-safe evaluation",
  "identity_fields": [
    "job_id",
    "candidate_id",
    "checkpoint_sha256",
    "opponent_id",
    "seat",
    "replicate",
    "requested_seed",
    "phase"
  ],
  "rule": "every worker result returns the submitted identity verbatim; the worker additionally re-hashes the checkpoint file it loaded and fingerprints the deck it played. No positional reattachment exists anywhere in the pipeline.",
  "assertions": [
    "submitted job_ids unique",
    "returned job_ids unique",
    "submitted set == returned set",
    "candidate_id in frozen registry",
    "checkpoint hash matches registry and worker-verified hash",
    "opponent/seat/phase/replicate/requested_seed round-trip",
    "exact expected count per candidate/opponent/seat",
    "no unexpected candidate/opponent/seat cells",
    "every game terminal or explicitly defect-classified",
    "deck fingerprint equals the frozen deck"
  ],
